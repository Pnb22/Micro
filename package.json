{
  "name": "micro-frontends-demo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel start:container start:menu start:order",
    "start:container": "npm --prefix packages/container start",
    "start:menu": "npm --prefix packages/menu start",
    "start:order": "npm --prefix packages/order start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
